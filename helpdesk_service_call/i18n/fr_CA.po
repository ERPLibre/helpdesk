"                <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">The ticket ${object.number} has been created from supplier applicant. Thanks!\n"
"                    <br>\n"
"                    Received informations by ${object.channel}\n"
"                    <br>\n"
"                    Nom: ${object.partner_name}\n"
"                    <br>\n"
"                    Email: ${object.partner_email}\n"
"                    <br>\n"
"                    Phone: ${object.partner_phone}\n"
"                    <br>\n"
"                    Address: ${object.partner_address}\n"
"                    <br>\n"
"                    Address invoice: ${object.partner_address_invoice.name if object.partner_address_invoice else \"\"}\n"
"                    <br>\n"
"                    Description: ${object.description}\n"
"                    <br>\n"
"                    Actual stage: ${object.stage_id.name if object.stage_id else \"\"}\n"
"                    <br>\n"
"                    Problem Location: ${object.problem_location}\n"
"                    <br>\n"
"                    Affected system: ${object.affected_system_id.name if object.affected_system_id else \"\"}\n"
"                </p>\n"
"            </data>"
